{
  "name": "create_finance_tables",
  "summary": "Adds accounts, people, categories and transactions so payments can be recorded and grouped.",
  "changes": [
    {
      "op": "create_table",
      "table": "accounts",
      "description": "Places where money is kept, such as a bank account or a wallet.",
      "columns": [
        {
          "name": "name",
          "description": "What the account is called.",
          "column_type": "text",
          "nullable": false,
          "unique": true,
          "references": null
        },
        {
          "name": "opening_balance",
          "description": "Money in the account when tracking started.",
          "column_type": "money",
          "nullable": false,
          "unique": false,
          "references": null
        }
      ]
    },
    {
      "op": "create_table",
      "table": "people",
      "description": "People whose spending is tracked, such as family members.",
      "columns": [
        {
          "name": "name",
          "description": "The person's name.",
          "column_type": "text",
          "nullable": false,
          "unique": true,
          "references": null
        }
      ]
    },
    {
      "op": "create_table",
      "table": "categories",
      "description": "Groups for spending and income, such as groceries or salary.",
      "columns": [
        {
          "name": "name",
          "description": "What the category is called.",
          "column_type": "text",
          "nullable": false,
          "unique": true,
          "references": null
        }
      ]
    },
    {
      "op": "create_table",
      "table": "transactions",
      "description": "Each payment received or made.",
      "columns": [
        {
          "name": "account_id",
          "description": "The account the money moved in or out of.",
          "column_type": "integer",
          "nullable": false,
          "unique": false,
          "references": "accounts"
        },
        {
          "name": "category_id",
          "description": "The group this payment falls under.",
          "column_type": "integer",
          "nullable": false,
          "unique": false,
          "references": "categories"
        },
        {
          "name": "occurred_on",
          "description": "The day the payment happened.",
          "column_type": "date",
          "nullable": false,
          "unique": false,
          "references": null
        },
        {
          "name": "amount",
          "description": "How much was paid. Negative for money spent.",
          "column_type": "money",
          "nullable": false,
          "unique": false,
          "references": null
        },
        {
          "name": "transfer_to_account",
          "description": "For a move between accounts, the account that received the money.",
          "column_type": "integer",
          "nullable": true,
          "unique": false,
          "references": null
        },
        {
          "name": "notes",
          "description": "Anything worth remembering about this payment.",
          "column_type": "text",
          "nullable": true,
          "unique": false,
          "references": null
        }
      ]
    }
  ]
}
