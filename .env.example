# Copy to .env (gitignored). nocodo-api loads it from the current folder or a parent.
# Variables already set in your shell take precedence.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
NEURALWATT_API_KEY=
# Set "provider" in project-base.json to a Rig selection: anthropic, openai,
# openrouter, deepseek, gcp.gemini/gemini, ... A missing key is reported with
# the exact variable name; an unknown provider lists the valid selections.
# neuralwatt (api.neuralwatt.com, OpenAI chat format) is added by nocodo itself.
# llamacpp (a local server) needs no key.
